.m-loading {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.m-loading__spinner {
  flex-shrink: 0;

  box-sizing: border-box;

  border-width: 3rpx;
  border-style: solid;
  border-radius: 50%;

  animation: m-loading-spin 0.8s linear infinite;
}

.m-loading__text {
  margin-left: 12rpx;

  font-size: 28rpx;
  line-height: 1.4;
}

@keyframes m-loading-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}