/* =========================
   Host
   ========================= */

.m-button-host {
  display: inline-block;
  box-sizing: border-box;
}

.m-button-host--block {
  display: block;
  width: 100%;
}

/* =========================
   Base
   ========================= */

.m-button {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 160rpx;
  margin: 0;
  padding: 0 32rpx;
  border: 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
  vertical-align: middle;
  overflow: hidden;
  transform: translateZ(0);
  transition:
    transform 0.12s ease,
    opacity 0.12s ease,
    box-shadow 0.12s ease;
}

.m-button::after {
  border: 0;
}

/* =========================
   Inner / Content
   ========================= */

.m-button__inner {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.m-button__content {
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

/* =========================
   Type
   ========================= */

.m-button--default {
  color: #1f2329;
  background-color: #f2f3f5;
}

.m-button--primary {
  color: #ffffff;
  background-color: #1677ff;
}

.m-button--danger {
  color: #ffffff;
  background-color: #e34d59;
}

/* =========================
   Size
   ========================= */

.m-button--small {
  height: 64rpx;
  min-width: 128rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.m-button--medium {
  height: 80rpx;
  font-size: 28rpx;
}

.m-button--large {
  height: 96rpx;
  min-width: 192rpx;
  padding: 0 40rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
}

/* =========================
   Block
   ========================= */

.m-button--block {
  display: flex;
  width: 100%;
  min-width: 0;
}

/* =========================
   Pressed
   ========================= */

.m-button--active {
  opacity: 0.88;
  transform: scale(0.985);
}

/* =========================
   Disabled / Loading
   ========================= */

.m-button--default.m-button--disabled {
  color: #c9cdd4;
  background-color: #f7f8fa;
}

.m-button--primary.m-button--disabled {
  color: rgba(255, 255, 255, 0.72);
  background-color: #94bfff;
}

.m-button--danger.m-button--disabled {
  color: rgba(255, 255, 255, 0.72);
  background-color: #f3a6ad;
}

.m-button--loading {
  pointer-events: none;
}

.m-button__loading {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
}

.m-button__loading-circle {
  box-sizing: border-box;
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid currentColor;
  border-bottom-color: transparent;
  border-radius: 999rpx;
  animation: m-button-spin 0.8s linear infinite;
}

@keyframes m-button-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}