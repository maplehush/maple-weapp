/* =========================
   Host
   ========================= */

.m-button-host {
  display: inline-block;
  box-sizing: border-box;
}

.m-button-host--block {
  display: block;
  width: 100%;
}

/* =========================
   Base
   ========================= */

.m-button {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 160rpx;
  margin: 0;
  padding: 0 var(--m-spacing-xl);
  border: 0;
  border-radius: var(--m-radius-medium);
  font-size: var(--m-font-size-medium);
  font-weight: var(--m-font-weight-medium);
  line-height: var(--m-line-height-tight);
  vertical-align: middle;
  overflow: hidden;
  transform: translateZ(0);
  transition:
    transform 0.12s ease,
    opacity 0.12s ease,
    box-shadow 0.12s ease;
}

.m-button::after {
  border: 0;
}

/* =========================
   Inner / Content
   ========================= */

.m-button__inner {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.m-button__content {
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

/* =========================
   Type
   ========================= */

.m-button--default {
  color: var(--m-text-color-primary);
  background-color: var(--m-bg-color-secondary);
}

.m-button--primary {
  color: var(--m-text-color-inverse);
  background-color: var(--m-color-primary);
}

.m-button--danger {
  color: var(--m-text-color-inverse);
  background-color: var(--m-color-danger);
}

/* =========================
   Size
   ========================= */

.m-button--small {
  height: var(--m-button-height-small);
  min-width: 128rpx;
  padding: 0 var(--m-spacing-lg);
  border-radius: var(--m-radius-small);
  font-size: var(--m-font-size-small);
}

.m-button--medium {
  height: var(--m-button-height-medium);
  font-size: var(--m-font-size-medium);
}

.m-button--large {
  height: var(--m-button-height-large);
  min-width: 192rpx;
  padding: 0 var(--m-button-padding-large);
  border-radius: var(--m-button-radius-large);
  font-size: var(--m-button-font-size-large);
}

/* =========================
   Block
   ========================= */

.m-button--block {
  display: flex;
  width: 100%;
  min-width: 0;
}

/* =========================
   Pressed
   ========================= */

.m-button--active {
  opacity: var(--m-state-active-opacity);
  transform: scale(0.985);
}

/* =========================
   Disabled / Loading
   ========================= */

.m-button--default.m-button--disabled {
  color: var(--m-text-color-disabled);
  background-color: var(--m-bg-color-disabled);
}

.m-button--primary.m-button--disabled {
  color: var(--m-state-inverse-disabled);
  background-color: var(--m-state-primary-disabled);
}

.m-button--danger.m-button--disabled {
  color: var(--m-state-inverse-disabled);
  background-color: var(--m-state-danger-disabled);
}

.m-button--loading {
  pointer-events: none;
}

.m-button__loading {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  margin-right: var(--m-spacing-sm);
}

.m-button__loading-circle {
  box-sizing: border-box;
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid currentColor;
  border-bottom-color: transparent;
  border-radius: var(--m-radius-round);
  animation: m-button-spin 0.8s linear infinite;
}

@keyframes m-button-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}