page {
  /* Brand */
  --m-color-primary: #1677ff;
  --m-color-success: #00a870;
  --m-color-warning: #ed7b2f;
  --m-color-danger: #e34d59;

  /* Text */
  --m-text-color-primary: #1f2329;
  --m-text-color-secondary: #4e5969;
  --m-text-color-placeholder: #86909c;
  --m-text-color-disabled: #c9cdd4;

  /* Background */
  --m-bg-color-page: #f7f8fa;
  --m-bg-color-container: #ffffff;
  --m-bg-color-secondary: #f2f3f5;

  /* Border */
  --m-border-color: #e5e6eb;

  /* Radius */
  --m-radius-small: 8rpx;
  --m-radius-medium: 16rpx;
  --m-radius-large: 24rpx;

  /* Font size */
  --m-font-size-small: 24rpx;
  --m-font-size-medium: 28rpx;
  --m-font-size-large: 32rpx;

  /* Spacing */
  --m-spacing-xs: 8rpx;
  --m-spacing-sm: 12rpx;
  --m-spacing-md: 16rpx;
  --m-spacing-lg: 24rpx;
  --m-spacing-xl: 32rpx;
}
