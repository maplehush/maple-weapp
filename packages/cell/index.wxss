.m-cell {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  padding: var(--m-cell-padding-y) var(--m-cell-padding-x);
  background-color: var(--m-bg-color-container);
  transition: background-color 0.12s ease, opacity 0.12s ease;
}

.m-cell--clickable {
  cursor: pointer;
}

.m-cell--disabled {
  opacity: 0.5;
}

.m-cell__body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 48rpx;
}

.m-cell__left {
  flex: 1;
  min-width: 0;
}

.m-cell__right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-width: 0;
  margin-left: var(--m-spacing-lg);
}

.m-cell__title {
  overflow: hidden;
  color: var(--m-text-color-primary);
  font-size: var(--m-font-size-medium);
  font-weight: var(--m-font-weight-medium);
  line-height: var(--m-line-height-normal);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.m-cell__label {
  margin-top: var(--m-spacing-xs);
  overflow: hidden;
  color: var(--m-text-color-placeholder);
  font-size: var(--m-font-size-small);
  line-height: var(--m-line-height-normal);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.m-cell__label--alone {
  margin-top: 0;
}

.m-cell__value {
  max-width: 320rpx;
  overflow: hidden;
  color: var(--m-text-color-placeholder);
  font-size: var(--m-font-size-medium);
  line-height: var(--m-line-height-normal);
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.m-cell__arrow {
  display: block;
  width: 24rpx;
  margin-left: var(--m-spacing-sm);
  color: var(--m-text-color-disabled);
  font-size: 36rpx;
  line-height: 1;
  text-align: center;
}

.m-cell--border::after {
  position: absolute;
  right: var(--m-cell-padding-x);
  bottom: 0;
  left: var(--m-cell-padding-x);
  height: 1rpx;
  background-color: var(--m-border-color);
  content: "";
}

.m-cell--active {
  background-color: var(--m-bg-color-page);
}