<view
  class="m-checkbox {{checked ? 'm-checkbox--checked' : ''}} {{indeterminate ? 'm-checkbox--indeterminate' : ''}} {{disabled ? 'm-checkbox--disabled' : ''}}"
  style="--m-checkbox-active-color: {{activeColor}};"
  role="checkbox"
  aria-checked="{{indeterminate ? 'mixed' : checked}}"
  bindtap="onTap"
>
  <view class="m-checkbox__box">
    <view wx:if="{{checked && !indeterminate}}" class="m-checkbox__check"></view>
    <view wx:if="{{indeterminate}}" class="m-checkbox__minus"></view>
  </view>
  <view class="m-checkbox__label">
    <slot />
  </view>
</view>
