.m-checkbox {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  color: var(--m-text-color-primary);
  font-size: var(--m-font-size-medium);
  line-height: var(--m-line-height-normal);
}

.m-checkbox__box {
  position: relative;
  flex: 0 0 auto;
  box-sizing: border-box;
  width: 40rpx;
  height: 40rpx;
  margin-right: var(--m-spacing-sm);
  border: 2rpx solid var(--m-border-color);
  border-radius: var(--m-radius-small);
  background-color: var(--m-bg-color-container);
  transition: background-color 0.12s ease, border-color 0.12s ease, opacity 0.12s ease;
}

.m-checkbox--checked .m-checkbox__box,
.m-checkbox--indeterminate .m-checkbox__box {
  border-color: var(--m-checkbox-active-color);
  background-color: var(--m-checkbox-active-color);
}

.m-checkbox__check {
  position: absolute;
  top: 8rpx;
  left: 12rpx;
  width: 10rpx;
  height: 18rpx;
  box-sizing: border-box;
  border-right: 3rpx solid var(--m-text-color-inverse);
  border-bottom: 3rpx solid var(--m-text-color-inverse);
  transform: rotate(45deg);
}

.m-checkbox__minus {
  position: absolute;
  top: 18rpx;
  left: 8rpx;
  width: 20rpx;
  height: 3rpx;
  border-radius: var(--m-radius-round);
  background-color: var(--m-text-color-inverse);
}

.m-checkbox__label {
  min-width: 0;
}

.m-checkbox--disabled {
  opacity: var(--m-state-disabled-opacity);
}
