<view class="m-navbar-placeholder" style="height: {{totalHeight}}px;">
  <view
    class="m-navbar {{fixed ? 'm-navbar--fixed' : ''}} {{border ? 'm-navbar--border' : ''}}"
    style="height: {{totalHeight}}px; padding-top: {{statusBarHeight}}px;"
  >
    <view class="m-navbar__content" style="height: {{navigationBarHeight}}px;">
      <view class="m-navbar__left" style="width: {{capsuleInset}}px;">
        <view
          wx:if="{{backable}}"
          class="m-navbar__back"
          hover-class="m-navbar__back--pressed"
          aria-role="button"
          aria-label="返回"
          bindtap="onBack"
        >
          <view class="m-navbar__back-icon" />
        </view>
        <slot name="left" />
      </view>
      <view class="m-navbar__title">{{title}}<slot /></view>
      <view class="m-navbar__spacer" style="width: {{capsuleInset}}px;" />
      <view class="m-navbar__right" style="right: {{capsuleInset}}px;">
        <slot name="right" />
      </view>
    </view>
  </view>
</view>
