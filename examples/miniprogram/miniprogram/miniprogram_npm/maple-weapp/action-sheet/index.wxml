<view wx:if="{{visible}}" class="m-action-sheet">
  <view class="m-action-sheet__mask" bindtap="onMaskTap"></view>
  <view class="m-action-sheet__container" catchtap="noop">
    <view class="m-action-sheet__header">
      <view class="m-action-sheet__title"><slot name="title" /></view>
    </view>
    <view class="m-action-sheet__actions">
      <view
        wx:for="{{actions}}"
        wx:key="index"
        class="m-action-sheet__action {{item.disabled ? 'm-action-sheet__action--disabled' : ''}}"
        data-index="{{index}}"
        bindtap="onActionTap"
      >
        <view class="m-action-sheet__action-title">{{item.name}}</view>
        <view wx:if="{{item.subname}}" class="m-action-sheet__action-subname">{{item.subname}}</view>
      </view>
    </view>
    <view wx:if="{{cancelText}}" class="m-action-sheet__cancel" bindtap="onCancel">{{cancelText}}</view>
  </view>
</view>
