<view class="m-textarea {{focused ? 'm-textarea--focused' : ''}} {{disabled ? 'm-textarea--disabled' : ''}} {{readonly ? 'm-textarea--readonly' : ''}}">
  <textarea
    class="m-textarea__control"
    value="{{value}}"
    placeholder="{{placeholder}}"
    placeholder-class="m-textarea__placeholder"
    maxlength="{{maxlength}}"
    disabled="{{disabled}}"
    cursor-spacing="24"
    auto-height="false"
    bindfocus="onFocus"
    bindinput="onInput"
    bindblur="onBlur"
  />

  <view class="m-textarea__footer">
    <view
      wx:if="{{clearable && value && !disabled && !readonly}}"
      class="m-textarea__clear"
      aria-label="clear"
      bindtap="onClear"
    >×</view>
    <view wx:if="{{showCount}}" class="m-textarea__count">{{value.length}}/{{maxlength}}</view>
  </view>
</view>
