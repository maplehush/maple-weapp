<view class="page-shell">
  <view class="page-navbar">
    <m-navbar title="{{doc ? doc.name : '组件详情'}}" backable fixed bindback="onBack" />
  </view>
  <scroll-view class="page-scroll" scroll-y type="list" show-scrollbar="{{false}}">
    <view wx:if="{{doc}}" class="detail-page">
  <view class="detail-header">
    <view>
      <view class="detail-name">{{doc.name}}</view>
      <view class="detail-title">{{doc.title}}</view>
    </view>
  </view>
  <block wx:if="{{componentId == 'icon'}}">
    <view class="detail-card">
      <view class="detail-section-title">基础图标</view>
      <view class="detail-section-desc">内置图标可直接通过 name 使用</view>
      <view class="icon-grid">
        <view wx:for="{{iconNames}}" wx:key="*this" class="icon-cell">
          <view class="icon-preview"><m-icon name="{{item}}" size="44" /></view>
          <view class="icon-name">{{item}}</view>
        </view>
      </view>
    </view>
    <view class="detail-card">
      <view class="detail-section-title">尺寸</view>
      <view class="icon-demo-row">
        <view wx:for="{{iconSizes}}" wx:key="value" class="icon-demo-item">
          <view class="icon-demo-preview"><m-icon name="search" size="{{item.value}}" /></view>
          <view class="icon-demo-label">{{item.label}} · {{item.value}}rpx</view>
        </view>
      </view>
    </view>
    <view class="detail-card">
      <view class="detail-section-title">颜色</view>
      <view class="icon-demo-row icon-color-row">
        <view wx:for="{{iconColors}}" wx:key="value" class="icon-demo-item">
          <view class="icon-demo-preview"><m-icon name="check" size="44" color="{{item.value}}" /></view>
          <view class="icon-demo-label">{{item.label}}</view>
        </view>
      </view>
    </view>
    <view class="detail-card">
      <view class="detail-section-title">图片图标</view>
      <view class="detail-section-desc">name 传入网络地址或本地路径时会自动使用 image 渲染</view>
      <view class="image-icon-demo">
        <m-icon name="{{imageIconUrl}}" size="80" />
        <view class="image-icon-copy">
          <view class="image-icon-title">本地 SVG</view>
          <view class="image-icon-url">{{imageIconUrl}}</view>
        </view>
      </view>
    </view>
  </block>
  <view class="detail-card">
    <view class="detail-section-title">介绍</view>
    <view class="detail-description">{{doc.description}}</view>
  </view>
  <view class="detail-card">
    <view class="detail-section-title">Props</view>
    <view wx:for="{{doc.props}}" wx:key="index" class="prop-row">
      <view class="prop-dot"></view>
      <view class="prop-text">{{item}}</view>
    </view>
  </view>
  <view class="detail-card">
    <view class="detail-section-title">使用</view>
    <view class="code-block"><text selectable>{{doc.usage}}</text></view>
  </view>
    </view>
    <view wx:else class="empty-page">
      <view class="empty-title">组件不存在</view>
      <view class="empty-link" bindtap="onBack">返回组件列表</view>
    </view>
  </scroll-view>
</view>
