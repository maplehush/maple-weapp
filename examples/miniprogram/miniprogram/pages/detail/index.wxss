.page-shell {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--m-bg-color-page);
}

.page-navbar {
  flex: none;
}

.page-scroll {
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
}

.detail-page {
  min-height: 100%;
  box-sizing: border-box;
  padding: 24rpx 32rpx 48rpx;
  background: var(--m-bg-color-page);
}
.detail-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0 32rpx;
}
.detail-name {
  color: var(--m-color-primary);
  font-size: 24rpx;
  font-weight: var(--m-font-weight-semibold);
}
.detail-title {
  margin-top: 4rpx;
  color: var(--m-text-color-primary);
  font-size: 38rpx;
  font-weight: var(--m-font-weight-semibold);
}
.detail-card {
  margin-bottom: 20rpx;
  padding: 28rpx 32rpx;
  border: 1rpx solid var(--m-border-color);
  border-radius: var(--m-radius-medium);
  background: var(--m-bg-color-container);
}
.detail-section-title {
  margin-bottom: 16rpx;
  color: var(--m-text-color-primary);
  font-size: 28rpx;
  font-weight: var(--m-font-weight-semibold);
}
.detail-section-desc {
  margin: -4rpx 0 24rpx;
  color: var(--m-text-color-secondary);
  font-size: 24rpx;
}
.icon-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx -20rpx;
}
.icon-cell {
  width: 25%;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  text-align: center;
}
.icon-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--m-radius-small);
  background: var(--m-bg-color-secondary);
  color: var(--m-color-primary);
}
.icon-name {
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--m-text-color-secondary);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.icon-demo-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
}
.icon-demo-item {
  min-width: 112rpx;
  text-align: center;
}
.icon-demo-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
}
.icon-demo-label {
  margin-top: 10rpx;
  color: var(--m-text-color-secondary);
  font-size: 21rpx;
}
.image-icon-demo {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-radius: var(--m-radius-small);
  background: var(--m-bg-color-secondary);
}
.image-icon-copy {
  min-width: 0;
  margin-left: 24rpx;
}
.image-icon-title {
  color: var(--m-text-color-primary);
  font-size: 26rpx;
  font-weight: var(--m-font-weight-medium);
}
.image-icon-url {
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--m-text-color-secondary);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.detail-description,
.prop-text {
  color: var(--m-text-color-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}
.prop-row {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
}
.prop-dot {
  width: 8rpx;
  height: 8rpx;
  margin: 12rpx 14rpx 0 0;
  border-radius: 50%;
  background: var(--m-color-primary);
}
.code-block {
  padding: 24rpx;
  border-radius: var(--m-radius-small);
  background: var(--m-bg-color-secondary);
  color: var(--m-text-color-primary);
  font-size: 23rpx;
  line-height: 1.6;
  word-break: break-all;
}
.empty-page {
  padding: 160rpx 48rpx;
  text-align: center;
  background: var(--m-bg-color-page);
}
.empty-title {
  color: var(--m-text-color-primary);
  font-size: 32rpx;
}
.empty-link {
  margin-top: 24rpx;
  color: var(--m-color-primary);
  font-size: 26rpx;
}
