<view class="page-shell">
  <view class="page-navbar"><m-navbar title="Maple Weapp" fixed /></view>
  <scroll-view class="page-scroll" scroll-y type="list" show-scrollbar="{{false}}">
    <view class="home-page">
  <view class="home-header">
    <view class="home-kicker">MAPLE WEAPP</view>
    <view class="home-title">组件库</view>
    <view class="home-subtitle">原生微信小程序组件与设计 Token 示例</view>
  </view>

  <view class="home-summary">
    <view class="summary-number">19</view>
    <view>
      <view class="summary-title">基础组件</view>
      <view class="summary-desc">点击组件卡片查看 API 与使用示例</view>
    </view>
  </view>

  <view class="section-title">Components</view>
  <view class="component-grid">
    <view
      wx:for="{{components}}"
      wx:key="id"
      class="component-card"
      data-id="{{item.id}}"
      bindtap="onComponentTap"
    >
      <view class="component-card__top">
        <view class="component-card__name">{{item.name}}</view>
        <view class="component-card__arrow">›</view>
      </view>
      <view class="component-card__title">{{item.title}}</view>
      <view class="component-card__desc">{{item.description}}</view>
    </view>
  </view>

    </view>
  </scroll-view>
</view>
