.demo-page {
  box-sizing: border-box;

  min-height: 100vh;

  padding: 32rpx;

  background-color: #ffffff;
}

.demo-title {
  margin-bottom: 48rpx;

  color: #1f2329;

  font-size: 40rpx;
  font-weight: 600;
}

.demo-section {
  margin-bottom: 48rpx;
}

.demo-section__title {
  margin-bottom: 24rpx;

  color: #86909c;

  font-size: 26rpx;
}

.demo-item {
  margin-bottom: 24rpx;
}

.demo-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;

  gap: 20rpx;
}

.demo-block {
  width: 100%;
}

