.demo-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: var(--m-spacing-xl);
  background-color: var(--m-bg-color-page);
}

.demo-title {
  margin-bottom: var(--m-spacing-xs);
  color: var(--m-text-color-primary);
  font-size: 40rpx;
  font-weight: var(--m-font-weight-semibold);
}

.demo-subtitle {
  margin-bottom: var(--m-spacing-xl);
  color: var(--m-text-color-secondary);
  font-size: var(--m-font-size-small);
  line-height: var(--m-line-height-normal);
}

.demo-section {
  margin-bottom: 48rpx;
}

.demo-section__title {
  margin-bottom: var(--m-spacing-lg);
  color: var(--m-text-color-placeholder);
  font-size: var(--m-font-size-small);
  font-weight: var(--m-font-weight-medium);
}

.demo-item {
  margin-bottom: var(--m-spacing-lg);
}

.demo-item--spaced {
  margin-top: var(--m-spacing-lg);
}

.demo-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--m-spacing-md);
}

.demo-row--icons {
  min-height: 64rpx;
  font-size: 32rpx;
}

