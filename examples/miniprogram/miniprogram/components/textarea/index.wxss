.m-textarea {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-height: 240rpx;
  padding: var(--m-spacing-lg);
  background-color: var(--m-bg-color-container);
  border: 1rpx solid var(--m-border-color);
  border-radius: var(--m-radius-small);
  transition: border-color 0.12s ease, opacity 0.12s ease;
}

.m-textarea--focused { border-color: var(--m-color-primary); }
.m-textarea--disabled { background-color: var(--m-bg-color-disabled); opacity: var(--m-state-disabled-opacity); }
.m-textarea--readonly { background-color: var(--m-bg-color-secondary); }

.m-textarea__control {
  display: block;
  box-sizing: border-box;
  width: 100%;
  height: 192rpx;
  color: var(--m-text-color-primary);
  font-size: var(--m-font-size-medium);
  line-height: var(--m-line-height-normal);
}

.m-textarea__placeholder { color: var(--m-text-color-placeholder); }

.m-textarea__footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 40rpx;
  margin-top: var(--m-spacing-xs);
}

.m-textarea__clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-right: var(--m-spacing-sm);
  color: var(--m-text-color-secondary);
  font-size: 32rpx;
  line-height: 1;
}

.m-textarea__count {
  color: var(--m-text-color-placeholder);
  font-size: var(--m-font-size-small);
  line-height: var(--m-line-height-tight);
}
