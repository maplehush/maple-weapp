{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",

    "strict": true,
    "noImplicitAny": false,
    "noImplicitThis": false,

    "skipLibCheck": true,

    "types": [
      "miniprogram-api-typings"
    ]
  },

  "include": [
    "packages/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "examples"
  ]
}